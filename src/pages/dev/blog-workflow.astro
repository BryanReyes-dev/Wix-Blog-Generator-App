---
import BlogWorkflowPreview from "../../components/dev/BlogWorkflowPreview";

// Prevent this preview page from being used in production.
if (!import.meta.env.DEV) {
  return Astro.redirect("/");
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Blog Workflow Preview</title>
  </head>

  <body>
    <BlogWorkflowPreview client:load />
  </body>
</html>

<style is:global>
  html,
  body {
    margin: 0;
    min-height: 100%;
  }

  body {
    box-sizing: border-box;
    padding: 24px;
    background: #eef2f7;
  }

  @media (max-width: 620px) {
    body {
      padding: 12px;
    }
  }
</style>